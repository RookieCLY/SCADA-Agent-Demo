# LLM provider keys (Phase 2+; not required for Phase 1 — mock LLM is built-in)
#
# THIS FILE IS TRACKED. Never paste a real key here — put it in .env, which is
# gitignored. A live XIAOMI-MIMO key sat on the line below from the first
# commit until 2026-08-15; it is scrubbed here but REMAINS IN GIT HISTORY, so
# that key must be treated as disclosed and rotated at the provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
XIAOMI-MIMO_API_KEY=
XIAOMI-MIMO_API_URL=https://token-plan-cn.xiaomimimo.com/v1
XIAOMI-MIMO_MODEL=mimo-v2.5-pro

# docode (OpenAI-compatible endpoint). The reasoning tier is a request
# parameter, not a model name (see DOCODE_REASONING_EFFORT).
#
# DOCODE_API_KEYS enables endpoint FAILOVER: comma-separated key@url pairs,
# tried in order, rotating on billing/auth/availability errors (401/402/403/
# 404/429/5xx and connection failures) with the working endpoint sticky per
# process. The model name and reasoning effort live in the request, so a
# mid-run rotation cannot change what is measured. If unset, the single
# DOCODE_API_KEY/DOCODE_API_URL pair is used.
DOCODE_API_KEYS=
DOCODE_API_KEY=
DOCODE_API_URL=https://docode.cc/v1
DOCODE_MODEL=gpt-5.6-terra
# Optional reasoning-effort tier sent as `reasoning_effort` in the request body
# (low/medium/high/xhigh/max where the endpoint supports it). Empty sends
# nothing, which reproduces every archived run.
DOCODE_REASONING_EFFORT=

# Langfuse (optional; tracer falls back to JSONL-only when these are empty)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
