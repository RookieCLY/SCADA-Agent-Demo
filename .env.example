# LLM provider keys (Phase 2+; not required for Phase 1 — mock LLM is built-in)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
XIAOMI-MIMO_API_KEY=tp-cj318r1mqmbx4jsfbbndb4purdky2wedxvto4g0j72h9axle
XIAOMI-MIMO_API_URL=https://token-plan-cn.xiaomimimo.com/v1
XIAOMI-MIMO_MODEL=mimo-v2.5-pro

# docode (OpenAI-compatible endpoint). Endpoint serves gpt-5.5, gpt-5.6-luna,
# gpt-5.6-sol and gpt-5.6-terra — query /v1/models for the current list.
# gpt-5.6-luna-max does not exist; there is no -max tier here — the reasoning
# tier is a request parameter, not a model name (see DOCODE_REASONING_EFFORT).
DOCODE_API_KEY=
DOCODE_API_URL=https://docode.cc/v1
DOCODE_MODEL=gpt-5.6-luna
# Optional reasoning-effort tier sent as `reasoning_effort` in the request body
# (low/medium/high/xhigh/max where the endpoint supports it). Empty sends
# nothing, which reproduces every archived run.
DOCODE_REASONING_EFFORT=

# Langfuse (optional; tracer falls back to JSONL-only when these are empty)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
