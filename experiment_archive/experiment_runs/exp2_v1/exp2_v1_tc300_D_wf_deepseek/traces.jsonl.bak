e_project", "show_deployment_status"]}, {"name": "manage_pages", "allowed_actions": ["list_pages"]}, {"name": "manage_history", "allowed_actions": ["list_history"]}, {"name": "manage_scripts", "allowed_actions": ["list_scripts"]}, {"name": "manage_points", "allowed_actions": ["list_points"]}], "visible_count": 5, "selected": "deployment", "action": "show_deployment_status", "args": {"action": "show_deployment_status"}, "schema_valid": true, "result_ok": true, "error_code": "OK", "error_msg": null, "result_data": {"deployment_id": "default", "status": "draft", "errors": []}, "world_diff": null, "latency_ms": 0.4622999986167997, "intended_entities": [], "referenced_entities": ["deployments.default"]}, {"turn": 4, "state": "MANAGE_PAGES", "visible_tools": [{"name": "deployment", "allowed_actions": ["validate_project", "deploy_project", "show_deployment_status", "rollback_deployment"]}], "visible_count": 1, "selected": "manage_pages", "action": "update_page", "args": {"action": "update_page", "page_id": "main_page", "properties": {"background_color": "#FFFFFF"}}, "schema_valid": false, "result_ok": false, "error_code": "SCHEMA_ERROR", "error_msg": "unknown action 'update_page' for domain 'manage_pages'; allowed: ['bind_point', 'create_page', 'create_widget', 'delete_page', 'get_backup', 'get_buffer', 'get_module', 'get_screen', 'list_pages', 'rename_page', 'set_gateway', 'set_parameter', 'set_pump', 'set_schedule', 'update_policy', 'update_recipe', 'update_topic', 'update_vessel']", "result_data": {}, "world_diff": null, "latency_ms": 0.012700000297627412, "intended_entities": [], "referenced_entities": []}, {"turn": 5, "state": "MANAGE_PAGES", "visible_tools": [{"name": "deployment", "allowed_actions": ["validate_project", "deploy_project", "show_deployment_status", "rollback_deployment"]}], "visible_count": 1, "selected": "manage_pages", "action": "get_screen", "args": {"action": "get_screen", "page_id": "main_page"}, "schema_valid": true, "result_ok": true, "error_co