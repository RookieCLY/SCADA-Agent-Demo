 {"name": "manage_history", "allowed_actions": ["list_history"]}, {"name": "manage_points", "allowed_actions": ["list_points"]}, {"name": "manage_scripts", "allowed_actions": ["list_scripts"]}], "visible_count": 5, "selected": "manage_points", "action": "list_points", "args": {"action": "list_points"}, "schema_valid": true, "result_ok": true, "error_code": "OK", "error_msg": null, "result_data": {"count": 2, "points": [{"tag": "WS1_Status", "type": "digital", "unit": null, "min": null, "max": null, "description": null}, {"tag": "WS2_Status", "type": "digital", "unit": null, "min": null, "max": null, "description": null}]}, "world_diff": null, "latency_ms": 0.7458000000042375, "intended_entities": [], "referenced_entities": []}, {"turn": 3, "state": "ANALYZE_INTENT", "visible_tools": [{"name": "deployment", "allowed_actions": ["show_deployment_status", "deploy_project", "validate_project", "rollback_deployment"]}], "visible_count": 1, "selected": "manage_pages", "action": "list_pages", "args": {"action": "list_pages"}, "schema_valid": true, "result_ok": true, "error_code": "OK", "error_msg": null, "result_data": {"count": 1, "pages": [{"id": "ws1", "name": "车间一"}]}, "world_diff": null, "latency_ms": 0.972999998339219, "intended_entities": [], "referenced_entities": []}, {"turn": 4, "state": "ANALYZE_INTENT", "visible_tools": [{"name": "deployment", "allowed_actions": ["show_deployment_status", "deploy_project", "validate_project", "rollback_deployment"]}], "visible_count": 1, "selected": "deployment", "action": "validate_project", "args": {"action": "validate_project", "deployment_id": "default"}, "schema_valid": true, "result_ok": true, "error_code": "OK", "error_msg": null, "result_data": {"deployment_id": "default", "errors": [], "status": "validated"}, "world_diff": {"added_or_modified": {"deployments.default": {"id": "default", "target": "default", "status": "validated", "validation_errors": [], "notes": ""}}, "removed": []}, "latency_ms": 0.995399999737856, "in