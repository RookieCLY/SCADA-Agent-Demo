 0.6, "use_reranker": true}, "workflow": {"enabled": true, "selected_workflow": "PointBinding"}, "totals": {"input_tokens": 13633, "output_tokens": 776, "cost_usd": 0.0, "e2e_latency_ms": 23002.88460002048}, "judge": null}
