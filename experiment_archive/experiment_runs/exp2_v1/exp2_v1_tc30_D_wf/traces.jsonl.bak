"alpha": 0.6, "use_reranker": true}, "workflow": {"enabled": true, "selected_workflow": "DeploymentCheck"}, "totals": {"input_tokens": 3013, "output_tokens": 748, "cost_usd": 0.0, "e2e_latency_ms": 20747.34190001618}, "judge": null}
