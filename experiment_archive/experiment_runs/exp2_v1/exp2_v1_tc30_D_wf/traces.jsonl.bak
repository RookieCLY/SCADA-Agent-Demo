_reranker": true}, "workflow": {"enabled": true, "selected_workflow": "HistoryQuery"}, "totals": {"input_tokens": 2194, "output_tokens": 682, "cost_usd": 0.0, "e2e_latency_ms": 17067.43870000355}, "judge": null}
