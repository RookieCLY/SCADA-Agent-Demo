ze the results for the user."}], "rag": {"enabled": false, "top_n": 30, "top_k": 12, "alpha": 0.6, "use_reranker": true}, "workflow": {"enabled": false, "selected_workflow": null}, "totals": {"input_tokens": 19460, "output_tokens": 452, "cost_usd": 0.0, "e2e_latency_ms": 21561.940899991896}, "judge": null}
