easoning": "The alarm was created successfully. Let me summarize the configuration for the user."}], "rag": {"enabled": false, "top_n": 30, "top_k": 12, "alpha": 0.6, "use_reranker": true}, "workflow": {"enabled": false, "selected_workflow": null}, "totals": {"input_tokens": 19354, "output_tokens": 369, "cost_usd": 0.0, "e2e_latency_ms": 18786.509500001557}, "judge": null}
