, "use_reranker": true}, "workflow": {"enabled": false, "selected_workflow": null}, "totals": {"input_tokens": 9532, "output_tokens": 218, "cost_usd": 0.0, "e2e_latency_ms": 7406.851799983997}, "judge": null}
