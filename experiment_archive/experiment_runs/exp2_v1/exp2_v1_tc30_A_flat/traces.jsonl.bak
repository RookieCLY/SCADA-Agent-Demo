ted for the user."}], "rag": {"enabled": false, "top_n": 30, "top_k": 12, "alpha": 0.6, "use_reranker": true}, "workflow": {"enabled": false, "selected_workflow": null}, "totals": {"input_tokens": 19342, "output_tokens": 390, "cost_usd": 0.0, "e2e_latency_ms": 23545.38780002622}, "judge": null}
