bled": true, "top_n": 30, "top_k": 12, "alpha": 0.6, "use_reranker": true}, "workflow": {"enabled": true, "selected_workflow": "AlarmConfig"}, "totals": {"input_tokens": 3100, "output_tokens": 872, "cost_usd": 0.0, "e2e_latency_ms": 25014.881399984006}, "judge": null}
