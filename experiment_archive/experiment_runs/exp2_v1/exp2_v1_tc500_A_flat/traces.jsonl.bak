nabled": false, "top_n": 30, "top_k": 12, "alpha": 0.6, "use_reranker": true}, "workflow": {"enabled": false, "selected_workflow": null}, "totals": {"input_tokens": 128802, "output_tokens": 399, "cost_usd": 0.0, "e2e_latency_ms": 15887.230799999088}, "judge": null}
