hree points first."}], "rag": {"enabled": false, "top_n": 30, "top_k": 12, "alpha": 0.6, "use_reranker": true}, "workflow": {"enabled": false, "selected_workflow": null}, "totals": {"input_tokens": 64231, "output_tokens": 405, "cost_usd": 0.0, "e2e_latency_ms": 12698.808799963444}, "judge": null}
