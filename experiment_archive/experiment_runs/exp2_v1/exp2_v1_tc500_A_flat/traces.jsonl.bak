et the user know that there are currently no pages in the project, and ask if they want to create a page first."}], "rag": {"enabled": false, "top_n": 30, "top_k": 12, "alpha": 0.6, "use_reranker": true}, "workflow": {"enabled": false, "selected_workflow": null}, "totals": {"input_tokens": 128599, "output_tokens": 299, "cost_usd": 0.0, "e2e_latency_ms": 12302.648600016255}, "judge": null}
