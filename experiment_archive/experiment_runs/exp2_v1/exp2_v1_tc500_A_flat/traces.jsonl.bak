": 12, "alpha": 0.6, "use_reranker": true}, "workflow": {"enabled": false, "selected_workflow": null}, "totals": {"input_tokens": 193371, "output_tokens": 376, "cost_usd": 0.0, "e2e_latency_ms": 18853.35449996637}, "judge": null}
