alse, "top_n": 30, "top_k": 12, "alpha": 0.6, "use_reranker": true}, "workflow": {"enabled": false, "selected_workflow": null}, "totals": {"input_tokens": 128727, "output_tokens": 410, "cost_usd": 0.0, "e2e_latency_ms": 17666.24779999256}, "judge": null}
