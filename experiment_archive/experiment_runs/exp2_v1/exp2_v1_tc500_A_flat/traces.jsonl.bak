01 with on_change storage mode."}], "rag": {"enabled": false, "top_n": 30, "top_k": 12, "alpha": 0.6, "use_reranker": true}, "workflow": {"enabled": false, "selected_workflow": null}, "totals": {"input_tokens": 128562, "output_tokens": 231, "cost_usd": 0.0, "e2e_latency_ms": 9513.667099992745}, "judge": null}
