p_n": 30, "top_k": 12, "alpha": 0.6, "use_reranker": true}, "workflow": {"enabled": false, "selected_workflow": null}, "totals": {"input_tokens": 128602, "output_tokens": 266, "cost_usd": 0.0, "e2e_latency_ms": 10584.076300030574}, "judge": null}
