allowed_actions": ["list_history", "set_retention", "enable_history"]}, {"name": "manage_pages", "allowed_actions": ["bind_point"]}, {"name": "manage_security", "allowed_actions": ["restore_project"]}, {"name": "manage_devices", "allowed_actions": ["create_device", "configure_device_params"]}, {"name": "deployment", "allowed_actions": ["deploy_project"]}], "visible_count": 6, "selected": "manage_points", "action": "update_point", "args": {"action": "update_point", "tag": "LT_TANK_01", "unit": "m", "min": 0, "max": 10, "description": null}, "schema_valid": true, "result_ok": true, "error_code": "OK", "error_msg": null, "result_data": {"tag": "LT_TANK_01"}, "world_diff": {"added_or_modified": {"points.LT_TANK_01": {"tag": "LT_TANK_01", "type": "analog", "unit": "m", "min": 0.0, "max": 10.0, "description": null}}, "removed": []}, "latency_ms": 0.5653999996866332, "intended_entities": ["points.LT_TANK_01"], "referenced_entities": ["points.LT_TANK_01"]}, {"turn": 3, "state": "ANALYZE_INTENT", "visible_tools": [{"name": "manage_points", "allowed_actions": ["update_point", "create_point", "list_points", "delete_point"]}, {"name": "manage_history", "allowed_actions": ["list_history", "set_retention", "enable_history"]}, {"name": "manage_pages", "allowed_actions": ["bind_point"]}, {"name": "manage_security", "allowed_actions": ["restore_project"]}, {"name": "manage_devices", "allowed_actions": ["create_device", "configure_device_params"]}, {"name": "deployment", "allowed_actions": ["deploy_project"]}], "visible_count": 6, "selected": "manage_points", "action": "list_points", "args": {"action": "list_points"}, "schema_valid": true, "result_ok": true, "error_code": "OK", "error_msg": null, "result_data": {"count": 1, "points": [{"tag": "LT_TANK_01", "type": "analog", "unit": "m", "min": 0.0, "max": 10.0, "description": null}]}, "world_diff": null, "latency_ms": 0.5677000008290634, "intended_entities": [], "referenced_entities": []}, {"turn": 4, "state": "ANALYZE_INTENT", "visi