summarize the configuration for the user."}], "rag": {"enabled": false, "top_n": 30, "top_k": 12, "alpha": 0.6, "use_reranker": true}, "workflow": {"enabled": false, "selected_workflow": null}, "totals": {"input_tokens": 91414, "output_tokens": 509, "cost_usd": 0.0, "e2e_latency_ms": 19179.95439999504}, "judge": null}
