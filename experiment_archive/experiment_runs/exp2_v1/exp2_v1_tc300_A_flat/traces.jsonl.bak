figure_database_connection"}, {"name": "execute_sql_query"}, {"name": "set_retention_policy"}, {"name": "list_databases"}, {"name": "get_channel"}, {"name": "get_session"}, {"name": "get_state"}, {"name": "set_buffer"}, {"name": "set_module"}, {"name": "set_backup"}, {"name": "set_screen"}, {"name": "update_config"}, {"name": "update_valve"}, {"name": "update_trigger"}, {"name": "update_protocol"}, {"name": "create_notification_rule"}, {"name": "configure_notification_channel"}, {"name": "add_escalation_level"}, {"name": "test_notification"}, {"name": "list_notification_rules"}, {"name": "get_connection"}, {"name": "get_token"}, {"name": "get_layout"}, {"name": "set_cache"}, {"name": "set_sensor"}, {"name": "set_restore"}, {"name": "set_panel"}, {"name": "update_parameter"}, {"name": "update_pump"}, {"name": "update_schedule"}, {"name": "update_gateway"}], "visible_count": 300, "selected": "create_script", "action": "create_script", "args": {"id": "script_pi201_valve1", "name": "PI-201高压联锁控制valve1", "trigger": "on_event", "body": "# ============================================\n# PI-201 高压联锁脚本\n# 触发条件: on_event\n# 逻辑: 当 PI-201 压力值超过高限设定时，置位 valve1\n# ============================================\n\nHIGH_LIMIT = 100.0  # 高压阈值（单位取决于点位工程单位）\n\ndef on_event(event_data):\n    \"\"\"\n    事件触发入口函数\n    \"\"\"\n    try:\n        # 读取当前压力值\n        current_pressure = read_point(\"PI-201\")\n\n        if current_pressure is None:\n            log_warning(\"[PI-201] 读取压力值失败，跳过本次联锁判断\")\n            return\n\n        # 判断是否超限\n        if current_pressure > HIGH_LIMIT:\n            log_warning(f\"[PI-201] 压力过高: {current_pressure} > {HIGH_LIMIT}，正在置位 valve1 ...\")\n            write_point(\"valve1\", True)   # 置位阀门（打开/动作）\n            log_info(f\"[valve1] 已置位成功\")\n        else:\n            log_info(f\"[PI-201] 压力正常: {current_pressure}，无需动作\")\n\n    except Exception as e:\n        log_error(f\"[PI-201联锁脚本] 执行异常: {str(e)}\")\n"}, "schema_valid": true, "result_ok": true, "error_code": "OK", "error_msg": null, "result_data": {"script_id": "script_pi201_valve1"}, "world_diff": {"added_or_modified": {"scripts.script_pi201_valve1": {"id": "script_pi201_valve1", "name": "PI-201高压联锁控制valve1", "trigger": "on_event", "bound_tag": null, "period_s": null, "body": "# ============================================\n# PI-201 高压联锁脚本\n# 触发条件: on_event\n# 逻辑: 当 PI-201 压力值超过高限设定时，置位 valve1\n# ============================================\n\nHIGH_LIMIT = 100.0  # 高压阈值（单位取决于点位工程单位）\n\ndef on_event(event_data):\n    \"\"\"\n    事件触发入口函数\n    \"\"\"\n    try:\n        # 读取当前压力值\n        current_pressure = read_point(\"PI-201\")\n\n        if current_pressure is None:\n            log_warning(\"[PI-201] 读取压力值失败，跳过本次联锁判断\")\n            return\n\n        # 判断是否超限\n        if current_pressure > HIGH_LIMIT:\n            log_warning(f\"[PI-201] 压力过高: {current_pressure} > {HIGH_LIMIT}，正在置位 valve1 ...\")\n            write_point(\"valve1\", True)   # 置位阀门（打开/动作）\n            log_info(f\"[valve1] 已置位成功\")\n        else:\n            log_info(f\"[PI-201] 压力正常: {current_pressure}，无需动作\")\n\n    except Exception as e:\n        log_error(f\"[PI-201联锁脚本] 执行异常: {str(e)}\")\n", "enabled": true}}, "removed": []}, "latency_ms": 0.06799999391660094, "intended_entities": ["scripts.script_pi201_valve1"], "referenced_entities": []}], "resource_reads": [], "world_snapshots": {"initial_hash": "sha256:d88107776650cb454d9d573d07babb192ac66fb7faa1784b2aff648b26102014", "final_hash": "sha256:929a6489cf6a8736792d0a2a60d8c257be2a0332d3313e4c2ddc9bbfbda48800", "final_state_match": null, "match_mode": null, "diff_against_expected": {}}, "llm_calls": [{"turn": 1, "model": "mimo-v2.5-pro", "input_tokens": 45511, "output_tokens": 566, "latency_ms": 18083.541099971626, "stop_reason": "tool_use", "text": "好的，我来为您创建一个 **OnEvent 触发**的全局脚本，逻辑为：当压力点 `PI-201` 过高时，置位阀门 `valve1`。", "reasoning": "The user wants to create a global script with an OnEvent trigger. The logic should be: if PI-201 is too high, then set valve1. Let me create a script with the `create_script` tool.\n\nLet me break down the request:\n1. Create a new script\n2. Trigger type: on_event\n3. Logic: If PI-201 (pressure indicator) value is too high, set valve1\n\nI need to define a reasonable threshold for \"too high\" - I'll use a common pressure limit. Since the user didn't specify an exact value, I'll use a reasonable example value like 100 (could be PSI or bar depending on context).\n\nLet me create the script with appropriate body."}, {"turn": 2, "model": "mimo-v2.5-pro", "input_tokens": 46117, "output_tokens": 324, "latency_ms": 11908.585399971344, "stop_reason": "end_turn", "text": "脚本已创建成功！以下是配置摘要：\n\n| 项目 | 内容 |\n|---|---|\n| **脚本 ID** | `script_pi201_valve1` |\n| **脚本名称** | PI-201高压联锁控制valve1 |\n| **触发方式** | `on_event`（事件触发） |\n\n### 脚本逻辑说明\n\n```\n事件触发 → 读取 PI-201 压力值\n         → 判断是否 > HIGH_LIMIT (100.0)\n              ✅ 超限 → 置位 valve1 (写 True)\n              ❌ 正常 → 记录日志，不动作\n```\n\n### ⚠️ 请确认以下事项\n\n1. **高压阈值**：脚本中 `HIGH_LIMIT = 100.0` 是示例值，请根据实际工艺要求调整（当前阶段可通过 `update_script_body` 修改）。\n2. **点位存在性**：请确保 `PI-201`（模拟量点）和 `valve1`（数字量点）已在项目中正确创建。\n3. **valve1 语义**：脚本写入 `True` 表示\"置位/打开\"，如果您的阀门逻辑是反向的（True=关闭），需要取反。\n\n如需调整阈值或修改逻辑，请随时告诉我！", "reasoning": "The script was created successfully. Let me provide a summary to the user."}], "rag": {"enabled": false, "top_n": 30, "top_k": 12, "alpha": 0.6, "use_reranker": true}, "workflow": {"enabled": false, "selected_workflow": null}, "totals": {"input_tokens": 91628, "output_tokens": 890, "cost_usd": 0.0, "e2e_latency_ms": 30185.021799989045}, "judge": null}
