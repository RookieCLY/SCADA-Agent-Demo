r": true}, "workflow": {"enabled": true, "selected_workflow": "AlarmConfig"}, "totals": {"input_tokens": 3789, "output_tokens": 504, "cost_usd": 0.0, "e2e_latency_ms": 19548.108599999978}, "judge": null}
