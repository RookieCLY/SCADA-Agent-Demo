 is too high, set valve1 to 1 (open).\n\"\"\"\n# Read current value of PI-201\npi201_value = get_point_value(\"PI-201\")\n# Define high threshold (adjust as needed)\nHIGH_THRESHOLD = 100.0\n# Check if value exceeds threshold\nif pi201_value is not None and pi201_value > HIGH_THRESHOLD:\n    # Set valve1 to 1 (open)\n    set_point_value(\"valve1\", 1)\n    log_info(f\"PI-201 value {pi201_value} exceeded {HIGH_THRESHOLD}, valve1 opened.\")\nelse:\n    log_info(f\"PI-201 value {pi201_value} is normal.\")"}, "schema_valid": true, "result_ok": true, "error_code": "OK", "error_msg": null, "result_data": {"script_id": "script_pi201_valve1"}, "world_diff": {"added_or_modified": {"scripts.script_pi201_valve1": {"id": "script_pi201_valve1", "name": "PI-201 High Alarm Valve Control", "trigger": "on_event", "bound_tag": null, "period_s": null, "body": "\"\"\"\nOnEvent script: If PI-201 is too high, set valve1 to 1 (open).\n\"\"\"\n# Read current value of PI-201\npi201_value = get_point_value(\"PI-201\")\n# Define high threshold (adjust as needed)\nHIGH_THRESHOLD = 100.0\n# Check if value exceeds threshold\nif pi201_value is not None and pi201_value > HIGH_THRESHOLD:\n    # Set valve1 to 1 (open)\n    set_point_value(\"valve1\", 1)\n    log_info(f\"PI-201 value {pi201_value} exceeded {HIGH_THRESHOLD}, valve1 opened.\")\nelse:\n    log_info(f\"PI-201 value {pi201_value} is normal.\")", "enabled": true}}, "removed": []}, "latency_ms": 1.4162000006763265, "intended_entities": ["scripts.script_pi201_valve1"], "referenced_entities": []}, {"turn": 4, "state": "CONFIG_SCRIPT", "visible_tools": [{"name": "manage_scripts", "allowed_actions": ["create_script", "update_script_body", "list_scripts", "delete_script", "disable_script", "enable_script"]}, {"name": "manage_graphics", "allowed_actions": ["create_line"]}, {"name": "manage_points", "allowed_actions": ["create_point"]}, {"name": "manage_alarms", "allowed_actions": ["create_digital_alarm"]}, {"name": "manage_notifications", "allowed