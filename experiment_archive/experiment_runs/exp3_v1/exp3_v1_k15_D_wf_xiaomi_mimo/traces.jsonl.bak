该向用户询问缺失的信息，并说明当前工具的限制。"}], "rag": {"enabled": true, "top_n": 30, "top_k": 15, "alpha": 0.6, "use_reranker": true}, "workflow": {"enabled": true, "selected_workflow": null}, "totals": {"input_tokens": 3716, "output_tokens": 366, "cost_usd": 0.0, "e2e_latency_ms": 11851.336899999296}, "judge": null}
