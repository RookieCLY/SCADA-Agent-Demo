e user."}], "rag": {"enabled": true, "top_n": 30, "top_k": 15, "alpha": 0.6, "use_reranker": true}, "workflow": {"enabled": true, "selected_workflow": null}, "totals": {"input_tokens": 7602, "output_tokens": 385, "cost_usd": 0.0, "e2e_latency_ms": 13857.175199998892}, "judge": null}
