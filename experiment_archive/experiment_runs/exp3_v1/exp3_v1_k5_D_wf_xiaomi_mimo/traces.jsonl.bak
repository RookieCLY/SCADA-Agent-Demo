p_n": 30, "top_k": 5, "alpha": 0.6, "use_reranker": true}, "workflow": {"enabled": true, "selected_workflow": "AlarmConfig"}, "totals": {"input_tokens": 953, "output_tokens": 111, "cost_usd": 0.0, "e2e_latency_ms": 5294.8920000008}, "judge": null}
