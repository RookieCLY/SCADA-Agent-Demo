actual numeric values for both:"}], "rag": {"enabled": true, "top_n": 30, "top_k": 5, "alpha": 0.6, "use_reranker": true}, "workflow": {"enabled": true, "selected_workflow": "AlarmConfig"}, "totals": {"input_tokens": 48077, "output_tokens": 4710, "cost_usd": 0.0, "e2e_latency_ms": 110769.04139999987}, "judge": null}
