abled": true, "top_n": 30, "top_k": 30, "alpha": 0.6, "use_reranker": true}, "workflow": {"enabled": true, "selected_workflow": "AlarmConfig"}, "totals": {"input_tokens": 4292, "output_tokens": 610, "cost_usd": 0.0, "e2e_latency_ms": 23695.22059999872}, "judge": null}
